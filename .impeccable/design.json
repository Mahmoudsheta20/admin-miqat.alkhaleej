  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary page task; theme-specific action gold.",
      "html": "<button class=\"ds-primary\">إنشاء عقد</button>",
      "css": ".ds-primary{font-family:var(--font-ui,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:var(--radius-control);font-size:14px;font-weight:600;cursor:pointer;border:0;background:#9a620b;color:#fff;transition:background-color 150ms ease,transform 150ms ease}.ds-primary:hover{background:#805006}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:2px solid var(--accent-gold);outline-offset:3px;}:host-context(.dark) .ds-primary{background:#e8b654;color:#201a0f}:host-context(.dark) .ds-primary:hover{background:#f4c76b}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary page task with border and subtle fill.",
      "html": "<button class=\"ds-secondary\">عرض التفاصيل</button>",
      "css": ".ds-secondary{font-family:var(--font-ui,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:var(--radius-control);font-size:14px;font-weight:600;cursor:pointer;border:1px solid var(--border-color);background:var(--bg-card-subtle);color:var(--text-main);transition:background-color 150ms ease,border-color 150ms ease}.ds-secondary:hover{border-color:var(--border-hover);background:var(--bg-card)}.ds-secondary:focus-visible{outline:2px solid var(--accent-gold);outline-offset:3px;}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "description": "Destructive record action.",
      "html": "<button class=\"ds-danger\">حذف</button>",
      "css": ".ds-danger{font-family:var(--font-ui,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:var(--radius-control);font-size:14px;font-weight:600;cursor:pointer;background:rgba(244,63,94,.1);border:1px solid rgba(244,63,94,.25);color:#f43f5e;transition:background-color 150ms ease}.ds-danger:hover{background:rgba(244,63,94,.2)}.ds-danger:focus-visible{outline:2px solid var(--accent-gold);outline-offset:3px;}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Record search with a native search control.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" aria-label=\"البحث في النتائج\" placeholder=\"البحث في النتائج\" /></label>",
      "css": ".ds-search{position:relative;display:block}.ds-search svg{position:absolute;inset-inline-start:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none}.ds-search input{font-family:var(--font-ui,system-ui,sans-serif);box-sizing:border-box;width:100%;min-height:44px;padding:10px 42px;background:var(--input-bg);color:var(--text-main);border:1px solid var(--border-color);border-radius:var(--radius-control);font-size:14px;transition:border-color 150ms ease,box-shadow 150ms ease}.ds-search input:focus{outline:none;border-color:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,.15)}.ds-search input:focus-visible{outline:2px solid var(--accent-gold);outline-offset:3px;}@media(max-width:639px){.ds-search input{font-size:16px}}"
    },
    {
      "name": "Current navigation link",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Active role-aware sidebar destination.",
