      "css": ".ds-navigation{font-family:var(--font-ui,system-ui,sans-serif);display:flex;align-items:center;gap:11px;min-height:44px;padding:10px 12px;border-radius:8px;background:var(--accent-surface);color:var(--accent-gold);font-size:14px;font-weight:600;text-decoration:none;transition:background-color 150ms ease}.ds-navigation:hover{background:var(--accent-surface);color:var(--accent-gold)}.ds-navigation:focus-visible{outline:2px solid var(--accent-gold);outline-offset:3px;}"
