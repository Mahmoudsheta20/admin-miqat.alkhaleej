# Server-side Express origin; the browser always calls the same-origin /api/proxy/ rewrite.
BACKEND_URL="http://localhost:5001"
# Compatibility fallback for older server configuration; no browser credentials are sent directly here.
NEXT_PUBLIC_BACKEND_URL="http://localhost:5001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional development-only test-data controls (off by default).
NEXT_PUBLIC_ENABLE_DEMO_DATA="false"
